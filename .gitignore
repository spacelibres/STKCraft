# Everything Cargo produces.
/target
/dist

# A checkout of the sibling repository that holds the fonts (see `AGENTS.md`). CI clones it
# next to the workspace; it is never part of this repository.
/craft-fonts

# `plan/` is a local working folder: execution plans, observations of the reference
# workflow, screenshots and notes. It is never committed.
/plan
/log

# Editor and OS noise.
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local settings that must never travel. Scoped to the root so that a Cargo config at
# `.cargo/config.toml`, which carries the `cargo xtask` alias and must be committed, is not
# caught by the same pattern.
/config.toml
/config.toml.bak
/config.broken-*.toml

# Ephemeris and other bulk data. Kernels are fetched from their publisher (NAIF for the JPL
# ephemerides) with a pinned checksum and are never committed: `docs/ephemeris-data.md` lists the
# sources, `cargo xtask fetch-data` downloads and verifies them, and a deployment downloads the
# same files it needs rather than receiving a copy in the repository.
*.bsp
*.bpc
*.tpc
*.tf
/data/
